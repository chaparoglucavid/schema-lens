{
    "name": "cavid/schema-lens",
    "description": "See exactly what changed in your database. Git-diff style schema comparison for Laravel.",
    "keywords": [
        "laravel",
        "database",
        "schema",
        "migration",
        "diff",
        "mysql",
        "mariadb",
        "comparison"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cavid",
            "email": "cavid@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0",
        "illuminate/console": "^10.0",
        "illuminate/http": "^10.0",
        "illuminate/routing": "^10.0",
        "illuminate/view": "^10.0",
        "illuminate/cache": "^10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "SchemaLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchemaLens\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SchemaLens\\Providers\\SchemaLensServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
